---
import Layout from '../layouts/Layout.astro';
---

<Layout title="500 - Server error | Martin" description="Something went wrong on our end.">
  <main class="flex flex-col flex-1 items-center justify-center px-6 py-20">
    <div class="max-w-md w-full text-center">
      <p class="text-8xl font-mono font-bold text-accent mb-6 leading-none">500</p>
      <h1 class="text-xl font-mono font-bold text-foreground mb-3">Server error</h1>
      <p class="text-sm leading-relaxed text-muted-foreground mb-10 text-pretty">
        Something went wrong on our end. Try refreshing the page, or head back home. If the problem persists, feel free to open an issue on GitHub.
      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a
          class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-mono bg-primary text-primary-foreground rounded hover:opacity-90 transition-opacity"
          href="/"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          Go home
        </a>
        <a
          class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-mono bg-secondary text-secondary-foreground border border-border rounded hover:border-primary/50 transition-colors"
          href="https://github.com/maplibre/martin/issues"
          rel="noopener noreferrer"
          target="_blank"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          Open an issue
        </a>
      </div>
    </div>
  </main>
</Layout>
