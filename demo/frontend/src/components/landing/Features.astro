---
import type { FeatureEntry } from '../../content.config';
import Icon from '../Icon.astro';

interface Props {
  features: FeatureEntry[];
}

const { features } = Astro.props;
---

<section class="px-6 py-12 border-b border-border" aria-labelledby="features-heading">
  <div class="max-w-4xl mx-auto">
    <h2
      id="features-heading"
      class="text-xs font-mono text-muted-foreground uppercase tracking-widest mb-6"
    >
      Why Martin
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {
        features.map(({ icon, title, body }) => (
          <div class="flex flex-col gap-2" key={title}>
            <div class="flex items-center gap-2 text-accent">
              <Icon name={icon} size={14} />
              <span class="text-sm font-mono font-semibold text-foreground leading-snug">
                {title}
              </span>
            </div>
            <p class="text-xs leading-relaxed text-muted-foreground">{body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
